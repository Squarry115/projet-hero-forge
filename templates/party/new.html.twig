{% extends 'base.html.twig' %}

{% block title %}Créer un groupe{% endblock %}

{% block body %}
<h1>Créer un groupe d'aventure</h1>

{{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.description) }}
    {{ form_row(form.maxSize) }}
    <button type="submit">Créer le groupe</button>
{{ form_end(form) }}

<a href="{{ path('app_party_index') }}">← Retour</a>
{% endblock %}
